VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Paddle integration. Both payment environments are disabled by default.
# Store actual secrets in the server secret manager, never as VITE variables.
RELAY_PADDLE_SANDBOX_ENABLED=false
RELAY_PADDLE_LIVE_ENABLED=false
RELAY_BILLING_LAUNCH_APPROVED=false
RELAY_BILLING_TERMS_VERSION=
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_CORE_MONTHLY_PRICE_ID=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_CORE_ANNUAL_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
